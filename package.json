{
  "name": "forecaster-times",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "check-scripts": "tsc --project scripts/tsconfig.json",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "cron": "bun cron/src/index.ts",
    "generate:edition": "bun scripts/generate-edition.ts",
    "generate:front": "bun scripts/generate-front-page.ts",
    "generate:category": "bun scripts/generate-category-page.ts"
  },
  "workspaces": [
    "web",
    "configs",
    "engine",
    "cron"
  ],
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@biomejs/biome": "^2.5.10",
    "@repo/engine": "*",
    "turbo": "^2.10.11",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.4.2"
}
